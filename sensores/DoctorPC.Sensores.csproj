<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Lector de sensores de Doctor PC: temperaturas, cargas, relojes, potencia y ventiladores de CPU y GPU.
    Usa LibreHardwareMonitorLib (MPL-2.0, https://github.com/LibreHardwareMonitor/LibreHardwareMonitor).
    Se compila en GitHub Actions y se copia a engine/sensores para el instalador.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>DoctorPC.Sensores</AssemblyName>
    <RootNamespace>DoctorPC.Sensores</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Product>Doctor PC</Product>
    <Description>Lector de sensores de Doctor PC</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
